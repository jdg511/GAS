	(footprint "GAS_Parts:Relay_DPDT_Panasonic_TQ2"
		(layer "F.Cu")
		(uuid "126cd99d-ad1b-4db8-8a55-dc3180b8e7b9")
		(at 52 58)
		(descr "Panasonic TQ2 THT signal relay, DPDT, 10-pin, 2.54mm pitch, 7.62mm row spacing. Geometry per Panasonic TQ catalog ASCTB14E 202507 recommended PC board pattern (10 holes dia 1.0mm). Pad numbering mapped to KiCad Relay_DPDT symbol convention (A1/A2 coil, 11/12/14 pole1, 21/22/24 pole2) using SamacSys TQ2-5V pin functions: 1=coil+(A1), 2=NC1(12), 3=COM1(11), 4=NO1(14), 5/6=mech, 7=NO2(24), 8=COM2(21), 9=NC2(22), 10=coil-(A2). VERIFY NC/NO and coil polarity with one physical relay (continuity check) before assembling all boards.")
