(module "Relay_DPDT_Panasonic_TQ2" (layer F.Cu)
  (descr "Panasonic TQ2 THT signal relay, DPDT, 10-pin, 2.54mm pitch, 7.62mm row spacing. Geometry per Panasonic TQ catalog ASCTB14E 202507 recommended PC board pattern (10 holes dia 1.0mm). Pad numbering mapped to KiCad Relay_DPDT symbol convention (A1/A2 coil, 11/12/14 pole1, 21/22/24 pole2) using SamacSys TQ2-5V pin functions: 1=coil+(A1), 2=NC1(12), 3=COM1(11), 4=NO1(14), 5/6=mech, 7=NO2(24), 8=COM2(21), 9=NC2(22), 10=coil-(A2). VERIFY NC/NO and coil polarity with one physical relay (continuity check) before assembling all boards.")
  (tags "Relay DPDT Panasonic TQ2 THT Illicit Apothecary GAS")
  (attr through_hole)
  (fp_text reference K** (at 5.08 -10.5) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "TQ2-5V" (at 5.08 2.8) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user %R (at 5.08 -3.81) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -1.92 -8.31) (end 12.08 -8.31) (layer F.Fab) (width 0.2))
  (fp_line (start 12.08 -8.31) (end 12.08 0.69) (layer F.Fab) (width 0.2))
  (fp_line (start 12.08 0.69) (end -1.92 0.69) (layer F.Fab) (width 0.2))
  (fp_line (start -1.92 0.69) (end -1.92 -8.31) (layer F.Fab) (width 0.2))
  (fp_line (start -2.92 -9.37) (end 13.08 -9.37) (layer F.CrtYd) (width 0.1))
  (fp_line (start 13.08 -9.37) (end 13.08 1.75) (layer F.CrtYd) (width 0.1))
  (fp_line (start 13.08 1.75) (end -2.92 1.75) (layer F.CrtYd) (width 0.1))
  (fp_line (start -2.92 1.75) (end -2.92 -9.37) (layer F.CrtYd) (width 0.1))
  (fp_line (start -1.92 -8.31) (end -1.92 0.69) (layer F.SilkS) (width 0.2))
  (fp_line (start 12.08 -8.31) (end 12.08 0.69) (layer F.SilkS) (width 0.2))
  (fp_line (start -1.92 -8.31) (end 12.08 -8.31) (layer F.SilkS) (width 0.2))
  (fp_line (start -1.92 0.69) (end 12.08 0.69) (layer F.SilkS) (width 0.2))
  (fp_circle (center -1.2 1.3) (end -0.9 1.3) (layer F.SilkS) (width 0.2))
  (pad A1 thru_hole rect (at 0 0) (size 1.5 1.5) (drill 1) (layers *.Cu *.Mask))
  (pad 12 thru_hole circle (at 2.54 0) (size 1.5 1.5) (drill 1) (layers *.Cu *.Mask))
  (pad 11 thru_hole circle (at 5.08 0) (size 1.5 1.5) (drill 1) (layers *.Cu *.Mask))
  (pad 14 thru_hole circle (at 7.62 0) (size 1.5 1.5) (drill 1) (layers *.Cu *.Mask))
  (pad MP1 thru_hole circle (at 10.16 0) (size 1.5 1.5) (drill 1) (layers *.Cu *.Mask))
  (pad MP2 thru_hole circle (at 10.16 -7.62) (size 1.5 1.5) (drill 1) (layers *.Cu *.Mask))
  (pad 24 thru_hole circle (at 7.62 -7.62) (size 1.5 1.5) (drill 1) (layers *.Cu *.Mask))
  (pad 21 thru_hole circle (at 5.08 -7.62) (size 1.5 1.5) (drill 1) (layers *.Cu *.Mask))
  (pad 22 thru_hole circle (at 2.54 -7.62) (size 1.5 1.5) (drill 1) (layers *.Cu *.Mask))
  (pad A2 thru_hole circle (at 0 -7.62) (size 1.5 1.5) (drill 1) (layers *.Cu *.Mask))
)
