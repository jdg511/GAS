(module "Pot_Bourns_PTD904_SideAdjust" (layer F.Cu)
  (descr "Bourns PTD904-2015K-B503 4-gang 9 mm pot, side adjust, M7x0.75 bushing. Board stands perpendicular to the panel; origin = shaft axis at the mounting shoulder, +x away from the panel. Pads gp: g = gang 1..4 from the panel, p = 1 CCW / 2 wiper / 3 CW.")
  (tags "GAS Illicit Apothecary")
  (attr through_hole)
  (fp_text reference REF** (at 0 -9) (layer F.SilkS) (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "Pot_Bourns_PTD904_SideAdjust" (at 0 9) (layer F.Fab) (effects (font (size 1 1) (thickness 0.15))))
  (fp_line (start 0.0 -5.5) (end 17.2 -5.5) (layer F.Fab) (width 0.1))
  (fp_line (start 17.2 -5.5) (end 17.2 5.5) (layer F.Fab) (width 0.1))
  (fp_line (start 17.2 5.5) (end 0.0 5.5) (layer F.Fab) (width 0.1))
  (fp_line (start 0.0 5.5) (end 0.0 -5.5) (layer F.Fab) (width 0.1))
  (fp_line (start -7.0 -3.5) (end 0.0 -3.5) (layer F.Fab) (width 0.1))
  (fp_line (start 0.0 -3.5) (end 0.0 3.5) (layer F.Fab) (width 0.1))
  (fp_line (start 0.0 3.5) (end -7.0 3.5) (layer F.Fab) (width 0.1))
  (fp_line (start -7.0 3.5) (end -7.0 -3.5) (layer F.Fab) (width 0.1))
  (fp_line (start -7.5 -6.6) (end 18.0 -6.6) (layer F.CrtYd) (width 0.05))
  (fp_line (start 18.0 -6.6) (end 18.0 6.6) (layer F.CrtYd) (width 0.05))
  (fp_line (start 18.0 6.6) (end -7.5 6.6) (layer F.CrtYd) (width 0.05))
  (fp_line (start -7.5 6.6) (end -7.5 -6.6) (layer F.CrtYd) (width 0.05))
  (fp_line (start 0.0 -5.62) (end 17.32 -5.62) (layer F.SilkS) (width 0.12))
  (fp_line (start 17.32 -5.62) (end 17.32 5.62) (layer F.SilkS) (width 0.12))
  (fp_line (start 17.32 5.62) (end 0.0 5.62) (layer F.SilkS) (width 0.12))
  (fp_line (start 0.0 5.62) (end 0.0 -5.62) (layer F.SilkS) (width 0.12))
  (fp_text user "PANEL" (at -3.5 0) (layer F.Fab) (effects (font (size 0.8 0.8) (thickness 0.12))))
  (pad "13" thru_hole circle (at 5.0 -5.0) (size 1.8 1.8) (drill 1.1) (layers *.Cu *.Mask))
  (pad "12" thru_hole circle (at 5.0 0.0) (size 1.8 1.8) (drill 1.1) (layers *.Cu *.Mask))
  (pad "11" thru_hole rect (at 5.0 5.0) (size 1.8 1.8) (drill 1.1) (layers *.Cu *.Mask))
  (pad "23" thru_hole circle (at 7.5 -5.0) (size 1.8 1.8) (drill 1.1) (layers *.Cu *.Mask))
  (pad "22" thru_hole circle (at 7.5 0.0) (size 1.8 1.8) (drill 1.1) (layers *.Cu *.Mask))
  (pad "21" thru_hole circle (at 7.5 5.0) (size 1.8 1.8) (drill 1.1) (layers *.Cu *.Mask))
  (pad "33" thru_hole circle (at 12.5 -5.0) (size 1.8 1.8) (drill 1.1) (layers *.Cu *.Mask))
  (pad "32" thru_hole circle (at 12.5 0.0) (size 1.8 1.8) (drill 1.1) (layers *.Cu *.Mask))
