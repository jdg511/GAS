(module "Converter_DCDC_Mornsun_URA_YMD_THT" (layer F.Cu)
  (descr "Mornsun URA/URB_YMD-10WR3 isolated DC/DC, 25.4x25.4mm THT (industry-standard 1x1in 6-pin brick; also fits Traco TEN 10WIN, CUI PDQ10-D, Mean Well DKMW10F). Geometry from Mornsun datasheet 2025.01.21-B/4 p.5: top-view PCB layout, 2.54mm grid, rows 20.32mm apart; pin1 5.08mm from pin2 and 7.62mm from pin6; recommended hole 1.5mm. Pinout (dual output): 1=GND(in) 2=Vin 3=+Vo 4=0V 5=-Vo 6=Ctrl.")
  (tags "DCDC Mornsun URA2415YMD TQ GAS Illicit Apothecary")
  (attr through_hole)
  (fp_text reference PS** (at 2.54 -4.5) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "URA2415YMD-10WR3" (at 2.54 10.16) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user %R (at 2.54 12.7) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -10.16 -2.54) (end 15.24 -2.54) (layer F.Fab) (width 0.2))
  (fp_line (start 15.24 -2.54) (end 15.24 22.86) (layer F.Fab) (width 0.2))
  (fp_line (start 15.24 22.86) (end -10.16 22.86) (layer F.Fab) (width 0.2))
  (fp_line (start -10.16 22.86) (end -10.16 -2.54) (layer F.Fab) (width 0.2))
  (fp_line (start -10.28 -2.66) (end 15.36 -2.66) (layer F.SilkS) (width 0.15))
  (fp_line (start 15.36 -2.66) (end 15.36 22.98) (layer F.SilkS) (width 0.15))
  (fp_line (start 15.36 22.98) (end -10.28 22.98) (layer F.SilkS) (width 0.15))
  (fp_line (start -10.28 22.98) (end -10.28 -2.66) (layer F.SilkS) (width 0.15))
  (fp_circle (center -1.5 -3.6) (end -1.1 -3.6) (layer F.SilkS) (width 0.2))
  (fp_line (start -10.41 -2.79) (end 15.49 -2.79) (layer F.CrtYd) (width 0.05))
  (fp_line (start 15.49 -2.79) (end 15.49 23.11) (layer F.CrtYd) (width 0.05))
  (fp_line (start 15.49 23.11) (end -10.41 23.11) (layer F.CrtYd) (width 0.05))
  (fp_line (start -10.41 23.11) (end -10.41 -2.79) (layer F.CrtYd) (width 0.05))
  (pad 1 thru_hole rect (at 0 0) (size 2.5 2.5) (drill 1.5) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at -5.08 0) (size 2.5 2.5) (drill 1.5) (layers *.Cu *.Mask))
  (pad 6 thru_hole circle (at 7.62 0) (size 2.5 2.5) (drill 1.5) (layers *.Cu *.Mask))
  (pad 3 thru_hole circle (at -7.62 20.32) (size 2.5 2.5) (drill 1.5) (layers *.Cu *.Mask))
  (pad 4 thru_hole circle (at 2.54 20.32) (size 2.5 2.5) (drill 1.5) (layers *.Cu *.Mask))
  (pad 5 thru_hole circle (at 12.7 20.32) (size 2.5 2.5) (drill 1.5) (layers *.Cu *.Mask))
)
