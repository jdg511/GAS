(module "BarrelJack_SameSky_PJ-064B_Vertical" (layer F.Cu)
  (descr "Same Sky PJ-064B DC jack 5.5 x 2.5 mm, 5/16-32 bushing, PCB layout per pj-064x.pdf (1 centre pin, 3 sleeve, 2 switch). Origin = axis, 1 mm centre mark hole.")
  (tags "GAS Illicit Apothecary")
  (attr through_hole)
  (fp_text reference REF** (at 0 -9) (layer F.SilkS) (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "BarrelJack_SameSky_PJ-064B_Vertical" (at 0 9) (layer F.Fab) (effects (font (size 1 1) (thickness 0.15))))
  (fp_circle (center 0 0) (end 5.4 0) (layer F.Fab) (width 0.1))
  (fp_circle (center 0 0) (end 6.2 0) (layer F.CrtYd) (width 0.05))
  (fp_circle (center 0 0) (end 6.0 0) (layer F.SilkS) (width 0.12))
  (pad "3" thru_hole oval (at 0 -4.2) (size 2.5 1.3) (drill oval 2.0 0.8) (layers *.Cu *.Mask))
  (pad "1" thru_hole oval (at 0 3.8) (size 2.5 1.3) (drill oval 2.0 0.8) (layers *.Cu *.Mask))
  (pad "2" thru_hole oval (at 3.8 0) (size 1.3 2.5) (drill oval 0.8 2.0) (layers *.Cu *.Mask))
  (pad "" np_thru_hole circle (at 0 0) (size 1.0 1.0) (drill 1.0) (layers *.Cu *.Mask))
)
