  (fp_line (start -5.715 6.35) (end -5.715 -6.35) (layer F.Fab) (width 0.1))
  (fp_circle (center 0 0) (end 3.17 0) (layer F.Fab) (width 0.1))
  (fp_line (start -6.2 -6.85) (end 6.2 -6.85) (layer F.CrtYd) (width 0.05))
  (fp_line (start 6.2 -6.85) (end 6.2 6.85) (layer F.CrtYd) (width 0.05))
  (fp_line (start 6.2 6.85) (end -6.2 6.85) (layer F.CrtYd) (width 0.05))
  (fp_line (start -6.2 6.85) (end -6.2 -6.85) (layer F.CrtYd) (width 0.05))
  (fp_line (start -5.84 -6.47) (end 5.84 -6.47) (layer F.SilkS) (width 0.12))
  (fp_line (start 5.84 -6.47) (end 5.84 6.47) (layer F.SilkS) (width 0.12))
  (fp_line (start 5.84 6.47) (end -5.84 6.47) (layer F.SilkS) (width 0.12))
  (fp_line (start -5.84 6.47) (end -5.84 -6.47) (layer F.SilkS) (width 0.12))
  (fp_text user "1" (at -4.6 -6.2) (layer F.SilkS) (effects (font (size 0.8 0.8) (thickness 0.12))))
  (pad "1" thru_hole rect (at -2.415 -4.7) (size 2.6 2.6) (drill 1.6) (layers *.Cu *.Mask))
  (pad "2" thru_hole circle (at -2.415 0) (size 2.6 2.6) (drill 1.6) (layers *.Cu *.Mask))
  (pad "3" thru_hole circle (at -2.415 4.7) (size 2.6 2.6) (drill 1.6) (layers *.Cu *.Mask))
