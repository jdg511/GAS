  (pad "6" thru_hole circle (at 2.415 4.7) (size 2.6 2.6) (drill 1.6) (layers *.Cu *.Mask))
  (pad "" np_thru_hole circle (at 0 0) (size 1.0 1.0) (drill 1.0) (layers *.Cu *.Mask))
)
