(module "TemplateMark_1mm" (layer F.Cu)
  (descr "1 mm drill centre mark for using the bare PCB as an endcap drilling template")
  (tags "GAS Illicit Apothecary")
  (attr exclude_from_pos_files exclude_from_bom)
  (fp_text reference REF** (at 0 -9) (layer F.SilkS) (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "TemplateMark_1mm" (at 0 9) (layer F.Fab) (effects (font (size 1 1) (thickness 0.15))))
  (pad "" np_thru_hole circle (at 0 0) (size 1.0 1.0) (drill 1.0) (layers *.Cu *.Mask))
  (fp_line (start -2.5 0) (end -1 0) (layer F.SilkS) (width 0.15))
  (fp_line (start 1 0) (end 2.5 0) (layer F.SilkS) (width 0.15))
  (fp_line (start 0 -2.5) (end 0 -1) (layer F.SilkS) (width 0.15))
  (fp_line (start 0 1) (end 0 2.5) (layer F.SilkS) (width 0.15))
  (fp_circle (center 0 0) (end 1.6 0) (layer F.CrtYd) (width 0.05))
)
