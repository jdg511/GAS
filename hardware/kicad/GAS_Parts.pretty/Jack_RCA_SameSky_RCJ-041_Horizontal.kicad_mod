(module "Jack_RCA_SameSky_RCJ-041_Horizontal" (layer F.Cu)
  (descr "Same Sky (CUI) RCJ-041 right-angle PCB-mount RCA jack, metal, black. Pad 1 = center/signal, pad 2 = shield, MH1/MH2 = mounting posts. Geometry per SamacSys model of RCJ-04 series datasheet https://www.sameskydevices.com/product/resource/rcj-04.pdf. Colors: RCJ-041 black, -042 white, -043 red, -044 yellow (same footprint).")
  (tags "RCA jack audio Same Sky CUI RCJ-04 GAS Illicit Apothecary")
  (attr through_hole)
  (fp_text reference J** (at 3.49 -7.5) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "RCJ-041" (at 3.49 7.5) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user %R (at 3.49 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start 4 5) (end -6 5) (layer F.Fab) (width 0.2))
  (fp_line (start -6 5) (end -6 -5) (layer F.Fab) (width 0.2))
  (fp_line (start -6 -5) (end 4 -5) (layer F.Fab) (width 0.2))
  (fp_line (start 4 -5) (end 4 5) (layer F.Fab) (width 0.2))
  (fp_line (start 4 4.15) (end 13.5 4.15) (layer F.Fab) (width 0.2))
  (fp_line (start 13.5 4.15) (end 13.5 -4.15) (layer F.Fab) (width 0.2))
  (fp_line (start 13.5 -4.15) (end 4 -4.15) (layer F.Fab) (width 0.2))
  (fp_line (start 4 -4.15) (end 4 4.15) (layer F.Fab) (width 0.2))
  (fp_line (start -7.519 -6.488) (end 14.5 -6.488) (layer F.CrtYd) (width 0.1))
  (fp_line (start 14.5 -6.488) (end 14.5 6.488) (layer F.CrtYd) (width 0.1))
  (fp_line (start 14.5 6.488) (end -7.519 6.488) (layer F.CrtYd) (width 0.1))
  (fp_line (start -7.519 6.488) (end -7.519 -6.488) (layer F.CrtYd) (width 0.1))
  (fp_line (start -6 -2.5) (end -6 -5) (layer F.SilkS) (width 0.1))
  (fp_line (start -6 -5) (end 1.5 -5) (layer F.SilkS) (width 0.1))
  (fp_line (start -6 2.5) (end -6 5) (layer F.SilkS) (width 0.1))
  (fp_line (start -6 5) (end 1.5 5) (layer F.SilkS) (width 0.1))
  (fp_line (start 4 2) (end 4 -2) (layer F.SilkS) (width 0.1))
  (pad 1 thru_hole circle (at 0 0) (size 4.227 4.227) (drill 2.818) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at -4.5 0) (size 4.039 4.039) (drill 2.6926) (layers *.Cu *.Mask))
  (pad MH1 np_thru_hole circle (at 3.15 -4.25) (size 2.476 2.476) (drill 2.476) (layers *.Cu *.Mask))
  (pad MH2 np_thru_hole circle (at 3.15 4.25) (size 2.476 2.476) (drill 2.476) (layers *.Cu *.Mask))
)
