	(title_block
		(title "GAS Rev C - io-board (receivers + INST gain, Vol + tube 1, Wet/Dry, Output + tube 2 + tape, balanced out)")
		(date "2026-09-15")
		(rev "C")
		(company "Illicit Apothecary")
		(comment 1 "Jacks on jack-board (P6 audio, P7 mode); INST = +12 dB in / -12 dB out; footswitch trails = K7")
		(comment 2 "Vol pull (CTL_TUBE) = K2 + K3: 6GY8 section emulation after Vol and after Output")
		(comment 3 "Output pull (CTL_TAPE) = K4 tape stage; Source toggle Mono > Stereo = K1")
		(comment 4 "No tubes and no high voltage: JFET triode emulation (see definition doc)")
	)
