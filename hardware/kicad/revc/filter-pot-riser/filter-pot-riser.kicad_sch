	(title_block
		(title "GAS Rev C - filter-pot riser (carries one PTD904 4-gang pot, HPF or LPF)")
		(date "2026-09-21")
		(rev "C")
		(company "Illicit Apothecary")
		(comment 1 "Stands perpendicular to the control deck; the pot's own M7 bushing nut holds the assembly to the cap")
		(comment 2 "Per gang: CCW end = HI, wiper and CW end tied = W. CW lowers both filter corners")
		(comment 3 "Same board for HPF (circuit P5) and LPF (circuit P6): build 2")
	)
