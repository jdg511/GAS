	(title_block
		(title "GAS Rev C - Tank board (feedback injection, 4 tank drivers + recovery, Ext tank routing)")
		(date "2026-09-15")
		(rev "C")
		(company "Illicit Apothecary")
		(comment 1 "Rev C: replaces Rev A tank-driver-recovery and ext-tank-routing")
		(comment 2 "Main tanks 4AB1C1B (8 R input), 2nd tanks 9EB2C1B L / 9EB3C1B R (600 R input), all RCA")
		(comment 3 "Ext tanks toggle: A = engage (K2 sends, K3 returns), B = Parallel (K1), Series adds +6 dB (x2)")
		(comment 4 "Feedback return is summed with the wet send BEFORE the main tank, as the plugin")
	)
