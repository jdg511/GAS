wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="3250" y="200" width="130" height="320" as="geometry"/></mxCell><mxCell id="c54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c51" target="c53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c55" value="L Out meter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3424" y="205" width="120" height="50" as="geometry"/></mxCell><mxCell id="c56" value="R Out meter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3424" y="395" width="120" height="50" as="geometry"/></mxCell><mxCell id="c57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.0938;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c53" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.6875;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c53" target="c56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c59" value="Host Out&#10;L / R" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="3588" y="200" width="100" height="320" as="geometry"/></mxCell><mxCell id="c60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.0938;entryDx=0;entryDy=0;" edge="1" parent="1" source="c55" target="c59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6875;entryDx=0;entryDy=0;" edge="1" parent="1" source="c56" target="c59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=8 8;strokeColor=#b85450;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c44" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2689" y="90"/><mxPoint x="999" y="90"/></Array></mxGeometry></mxCell><mxCell id="c63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=8 8;strokeColor=#6a9153;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c47"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="600"/><mxPoint x="2853" y="600"/></Array></mxGeometry></mxCell><mxCell id="c64" value="red dashed: Fb Out, back round to Fb In" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1139" y="102" width="360" height="24" as="geometry"/></mxCell><mxCell id="c65" value="green dashed: dry tap, Host In straight to Wet / Dry" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="612" width="420" height="24" as="geometry"/></mxCell><mxCell id="c66" value="Orange = spring tank convolution.   Blue = a stereo stage on +/-15 V.   RED = the only block on the +9VC rail.   Green = per channel.&#10;Yellow = a gain.   Purple diamond = a sum.   Purple dashed = a path that skips a stage.   Lines that cross without joining hop over the one underneath.&#10;Supplies (circuit-board.kicad_sch): the L78L09 makes +9VC for the VBIAS buffer and the two Tube Screamer channels, and nothing else. Comp (MMBF5457 + OPA1679)&#10;and Limit (Coolaudio V2181 + OPA1679 detector) are both on +/-15 V, where a board node runs out of rail at about 14 V.&#10;Short% and Long% both come from the one Short/Long Reverb mix knob: Short% is 100 until noon then falls to 0, Long% rises from 0 to 100 by noon then stays 100." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="1900" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Ext Tanks: Series"><mxGraphModel dx="2200" dy="1200" grid="1" gridSize="10" page="1" pageWidth="5090" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="GAS Rev C  |  wet path  |  Ext Tanks = Series" style="text;html=1;whiteSpace=wrap;align=left;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1400" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Host In&#10;L / R" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="100" height="320" as="geometry"/></mxCell><mxCell id="c3" value="Pre Input&#10;-48 to +18 dB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="204" y="200" width="120" height="320" as="geometry"/></mxCell><mxCell id="c4" value="In&#10;-18 to +18 dB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="368" y="200" width="120" height="320" as="geometry"/></mxCell><mxCell id="c5" value="Tube&#10;J201&#10;(switch)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="532" y="200" width="100" height="320" as="geometry"/></mxCell><mxCell id="c6" value="rail 14 V&#10;(+/-15 V)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="676" y="200" 