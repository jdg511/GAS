></mxCell><mxCell id="c60" value="sum&#10;stage 2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2520" y="205" width="110" height="120" as="geometry"/></mxCell><mxCell id="c61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2083;entryDx=0;entryDy=0;" edge="1" parent="1" source="c52" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=4 4;strokeColor=#9673a6;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7917;entryDx=0;entryDy=0;" edge="1" parent="1" source="c53" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="sum&#10;stage 2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2520" y="395" width="110" height="120" as="geometry"/></mxCell><mxCell id="c64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2083;entryDx=0;entryDy=0;" edge="1" parent="1" source="c56" target="c63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=4 4;strokeColor=#9673a6;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7917;entryDx=0;entryDy=0;" edge="1" parent="1" source="c57" target="c63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c66" value="Series, as built. Each tank is blended against a bypass that goes around it.&#10;Hard left  = Short 100 / Long 0   : stage 2 passes stage 1 through, so short tank only.&#10;Noon       = Short 100 / Long 100 : a true cascade, short tank into long tank.&#10;Hard right = Short 0 / Long 100   : short bypassed, long tank fed the raw wet signal.&#10;NOTE: the +6 dB makeup sits before the long tank at EVERY knob position, so the&#10;hard-right (long only) end runs about 6 dB hotter than the hard-left (short only) end.&#10;NOTE: the long tank keeps convolving even when it is mixed all the way out.&#10;&#10;Predelay windows are one per lane, implemented 2026-09-30 in PluginProcessor.cpp (predelayLaneMinMs / predelayLaneMaxMs).&#10;Before that, L and R shared one window per pair (both short lanes 20 to 30, both long lanes 30 to 42). Each lane still wanders&#10;independently inside its own window, so L and R are now decorrelated from each other as well as from the long tanks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="1200" height="200" as="geometry"/></mxCell><mxCell id="c67" value="HPF&#10;Sallen-Key&#10;Q 0.71" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2674" y="200" width="100" height="320" as="geometry"/></mxCell><mxCell id="c68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2031;entryDx=0;entryDy=0;" edge="1" parent="1" source="c60" target="c67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7969;entryDx=0;entryDy=0;" edge="1" parent="1" source="c63" target="c67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c70" value="Gain&#10;-18 to +18 dB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2818" y="200" width="120" height="320" as="geometry"/></mxCell><mxCell id="c71" value="Dirt (Gain pull)&#10;TS808, TL072H&#10;1N4148W pair&#10;&#10;+9VC&#10;clips at +/-4.5 V" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="2982" y="200" width="150" height="320" as="geometry"/></mxCell><mxCell id="c72" value="Comp / Off / Limit&#10;&#10;Comp: MMBF5457 FET&#10;(1176 territory)&#10;Limit: V2181 VCA&#10;10:1&#10;&#10;+/-15 V" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="3176" y="200" width="170" height="320" as="geometry"/></mxCell><mxCell id="c73" value="LPF&#10;Sallen-Key&#10;Q 0.74" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="3390" y="200" width="100" height="320" as="geometry"/></mxCell><mxCell id="c74" value="rail 14 V&#10;(+/-15 V)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="3534" y="200" width="80" height="320" as="geometry"/></mxCell><mxCell id="c75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c67" target="c70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c70" target="c71"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c71" target="c72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c72" target="c73"><mxGeometry relative="1" as="geometry"/></mxCell