1" source="c81" target="c84"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c87" value="Wet / Dry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="3996" y="200" width="110" height="320" as="geometry"/></mxCell><mxCell id="c88" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c84" target="c87"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c89" value="Out&#10;-18 to +18 dB&#10;+ Tape" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="4150" y="200" width="130" height="320" as="geometry"/></mxCell><mxCell id="c90" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c87" target="c89"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c91" value="rail 14 V&#10;(+/-15 V)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="4324" y="200" width="80" height="320" as="geometry"/></mxCell><mxCell id="c92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c89" target="c91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c93" value="Post Output&#10;-48 to +18 dB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="4448" y="200" width="130" height="320" as="geometry"/></mxCell><mxCell id="c94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c91" target="c93"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c95" value="L Out meter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="4622" y="205" width="120" height="50" as="geometry"/></mxCell><mxCell id="c96" value="R Out meter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="4622" y="395" width="120" height="50" as="geometry"/></mxCell><mxCell id="c97" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.0938;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c93" target="c95"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.6875;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c93" target="c96"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c99" value="Host Out&#10;L / R" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="4786" y="200" width="100" height="320" as="geometry"/></mxCell><mxCell id="c100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.0938;entryDx=0;entryDy=0;" edge="1" parent="1" source="c95" target="c99"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6875;entryDx=0;entryDy=0;" edge="1" parent="1" source="c96" target="c99"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c102" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=8 8;strokeColor=#b85450;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c84" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3887" y="90"/><mxPoint x="999" y="90"/></Array></mxGeometry></mxCell><mxCell id="c103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=8 8;strokeColor=#6a9153;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c87"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="600"/><mxPoint x="4051" y="600"/></Array></mxGeometry></mxCell><mxCell id="c104" value="red dashed: Fb Out, back round to Fb In" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1139" y="102" width="360" height="24" as="geometry"/></mxCell><mxCell id="c105" value="green dashed: dry tap, Host In straight to Wet / Dry" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="612" width="420" height="24" as="geometry"/></mxCell><mxCell id="c106" value="Orange = spring tank convolution.   Blue = a stereo stage on +/-15 V.   RED = the only block on the +9VC rail.   Green = per channel.&#10;Yellow = a gain.   Purple diamond = a sum.   Purple dashed = a path that skips a stage.   Lines that cross without joining hop over the one underneath.&#10;Supplies (circuit-board.kicad_sch): the L78L09 makes +9VC for the VBIAS buffer and the two Tube Screamer channels, and nothing else. Comp (MMBF5457 + OPA1679)&#10;and Limit (Coolaudio V2181 + OPA1679 detector) are both on +/-15 V, where a board node runs out of rail at about 14 V.&#10;Short% and Long% both come from the one Short/Long Reverb mix knob: Short% is 100 until noon then falls to 0, Long% rises from 0 to 100 by noon then stays 100." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="1900" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Ext Tanks: Parallel"><mxGraphModel dx="2200" dy="1200" grid="1" gridSize="10" page="1" pageWidth="4220" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="GAS Rev C  |  wet path  |  Ext Tanks = Parallel" style="text;html=1;whiteSpace=wrap;align=left;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1400" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Host In&#10;L / R" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="100" height="320" as="geometry"/></mxCell><mxCell id="c3" value="Pre Input&#10;-48 to +18 dB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="204" y="200" width="120" height="320" as="geometry"/></mxCell><mxCell id="c4" value="In&#10;-18 to +18 dB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="368" y="200" width="120" height="320" as="geometry"/></mxCell><mxCell id="c5" value="Tube&#10;J201&#10;(switch)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="532" y="200" width="100" height="320" as="geometry"/></mxCell><mxCell id="c6" value="rail 14 V&#10;(+/-15 V)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="676" y="200" width="80" height="320" as="geometry"/></mxCell><mxCell id="c7" value="L In meter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="205" width="110" height="50" as="geometry"/></mxCell><mxCell id="c8" value="R In meter" style="rounded=1;whiteSpace=w