-        return false;
-    }
-
-    playbackBuffer = std::move (newBuffer);
-    playbackSourceSampleRate = reader->sampleRate;
-    playbackFilePath = displayName;
-    playbackReadPosition = 0.0;
-    playbackActive = false;
-    return true;
