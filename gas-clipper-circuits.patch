diff --git a/Source/DSP/ClipperCircuitModels.h b/Source/DSP/ClipperCircuitModels.h
new file mode 100644
index 0000000..48daa67
--- /dev/null
+++ b/Source/DSP/ClipperCircuitModels.h
@@ -0,0 +1,250 @@
+#pragma once
+
+#include <JuceHeader.h>
+
+#include <array>
+#include <cmath>
+#include <mutex>
+
+/**
+    Component-level models of the clipping circuits offered by the plugin.
+
+    Every curve here is solved from the Shockley diode equation against the real
+    component values of the circuit it represents, rather than being an ad-hoc
+    "sounds about right" waveshaper:
+
+        I_d(V) = Is * (exp(V / (N * n * Vt)) - 1)
+
+    The implicit node equation is solved once per table entry by bisection when
+    the plugin first loads, baked into a warped lookup table, and then read with
+    linear interpolation on the audio thread. The curves do not depend on sample
+    rate, so the tables are built exactly once and shared by every instance.
+
+    Reference level: digital 1.0 == 1.0 V peak at the clipper input.
+    Supply: 9 V biased to 4.5 V, so the op-amp saturates at +/-4.5 V. That rail
+    clamp is part of the model - crank the Drive and you get real op-amp
+    saturation on top of the diode clipping, exactly like the hardware.
+
+    The matching Python reference implementation lives in models/clipper_models.py.
+*/
+namespace gas::circuits
+{
+
+inline constexpr float kThermalVoltage = 0.02585f;   // kT/q at 300 K
+inline constexpr float kSupplyRail     = 4.5f;       // 9 V rail, biased to 4.5 V
+
+/** One diode type: saturation current and ideality factor. */
+struct Diode
+{
+    float saturationCurrent;   // Is, amperes
+    float ideality;            // n
+};
+
+// Is / n are chosen so the modelled forward voltage matches the datasheet
+// figures quoted alongside each part.
+inline constexpr Diode kDiode1N4148    { 2.52e-9f,  1.752f };  // Si, Vf 0.72 V @ 10 mA
+inline constexpr Diode kDiodeBAT41     { 1.20e-7f,  1.050f };  // Schottky, Vf 0.45 V @ 10 mA
+inline constexpr Diode kDiodeRedLed    { 9.00e-18f, 1.900f };  // GaAsP red LED, Vf 1.85 V @ 20 mA
+// Nexperia PMEG150G20ELP, 150 V / 2 A SiGe rectifier, CFP5 (SOD128).
+// Is / n fitted to the 25 C curve of datasheet Fig. 3 in the microamp-to-
+// milliamp region where a clipper actually works, not to the amp-level table
+// entries (those are dominated by ~58 mohm of series resistance, which is
+// irrelevant at signal currents). Gives Vf 0.44 V @ 1 mA.
+//
+// Note n = 1.13 against the 1N4148's 1.75: this part clips EARLIER than silicon
+// but with a considerably HARDER knee. It is not a germanium substitute - real
+// Ge is soft-kneed and leaky, while this is sharp and specified at 0.4 nA
+// reverse leakage.
+inline constexpr Diode kDiodePMEG150G20 { 2.863e-10f, 1.134f };
+inline constexpr Diode k2N3904BaseEmit { 6.73e-15f, 1.000f };  // 2N3904 B-E junction, n ~ 1.0
+
+enum class Topology
+{
+    /** Diodes across the op-amp feedback resistor (Tube Screamer / SD-1 / OCD).
+        Output keeps climbing with unity slope past the knee, so it never fully
+        squares off - this is what keeps these circuits touch sensitive. */
+    feedback,
+
+    /** Series resistor into a shunt diode stack (ladder clippers). A hard clamp
+        to the stack's forward voltage no matter how hard it is driven. */
+    shunt
+};
+
+/** A complete clipping circuit: topology, resistors, and the diode network. */
+struct CircuitSpec
+{
+    Topology topology;
+    float    seriesOrFeedbackR;   // Rf (feedback) or Rs (shunt), ohms
+    float    gainSetR;            // Rg for the feedback topology, ohms
+    float    inputStageGainDb;    // gain of the stage ahead of a shunt network
+
+    Diode positiveDiode;
+    int   positiveCount;          // diodes in series on the positive half
+    Diode negativeDiode;
+    int   negativeCount;          // diodes in series on the negative half
+
+    bool isAsymmetric() const noexcept
+    {
+        return positiveCount != negativeCount
+            || positiveDiode.saturationCurrent != negativeDiode.saturationCurrent
+            || positiveDiode.ideality != negativeDiode.ideality;
+    }
+};
+
+/** Current through `count` identical diodes stacked in series. */
+inline float diodeCurrent (float voltage, const Diode& diode, int count) noexcept
+{
+    const auto scale = static_cast<float> (count) * diode.ideality * kThermalVoltage;
+    const auto exponent = juce::jlimit (-80.0f, 80.0f, voltage / scale);
+    return diode.saturationCurrent * (std::exp (exponent) - 1.0f);
+}
+
+/** Net current through an anti-parallel diode network at a given voltage. */
+inline float networkCurrent (float voltage, const CircuitSpec& spec) noexcept
+{
+    return diodeCurrent (voltage, spec.positiveDiode, spec.positiveCount)
+         - diodeCurrent (-voltage, spec.negativeDiode, spec.negativeCount);
+}
+
+/** Solves the circuit's node equation for one input voltage.
+
+    feedback:  Vin/Rg = Vd/Rf + I_diodes(Vd),  Vout = Vin + Vd
+    shunt:     (Vin - Vout)/Rs = I_diodes(Vout)
+
+    Bisection rather than Newton: it cannot diverge on the stiff exponential,
+    and this only ever runs at load time.
+*/
+inline float solveCircuit (float inputVolts, const CircuitSpec& spec) noexcept
+{
+    const auto driven = inputVolts * juce::Decibels::decibelsToGain (spec.inputStageGainDb);
+
+    auto residual = [&] (float unknown)
+    {
+        if (spec.topology == Topology::feedback)
+            return driven / spec.gainSetR - (unknown / spec.seriesOrFeedbackR + networkCurrent (unknown, spec));
+
+        return (driven - unknown) / spec.seriesOrFeedbackR - networkCurrent (unknown, spec);
+    };
+
+    auto low  = -2.0f * kSupplyRail;
+    auto high =  2.0f * kSupplyRail;
+
+    // Widen the bracket if the solution sits outside it (only possible before
+    // the rail clamp bites, and cheap to guard against).
+    for (int attempt = 0; attempt < 8 && residual (low) * residual (high) > 0.0f; ++attempt)
+    {
+        low  *= 2.0f;
+        high *= 2.0f;
+    }
+
+    if (residual (low) * residual (high) > 0.0f)
+        return juce::jlimit (-kSupplyRail, kSupplyRail, driven);
+
+    for (int iteration = 0; iteration < 64; ++iteration)
+    {
+        const auto mid = 0.5f * (low + high);
+
+        if (residual (low) * residual (mid) <= 0.0f)
+            high = mid;
+        else
+            low = mid;
+    }
+
+    const auto solved = 0.5f * (low + high);
+    const auto output = (spec.topology == Topology::feedback) ? driven + solved : solved;
+
+    return juce::jlimit (-kSupplyRail, kSupplyRail, output);
+}
+
+//==============================================================================
+/** A solved circuit baked into a lookup table.
+
+    The table is indexed through a warp, u = v / (kWarp + |v|), which concentrates
+    resolution around zero where the knee lives while still reaching the tens of
+    volts a fully cranked Drive can produce.
+*/
+class CircuitCurve
+{
+public:
+    static constexpr int   kTableSize = 4096;
+    static constexpr float kWarp      = 0.5f;
+
+    void build (const CircuitSpec& spec)
+    {
+        asymmetric = spec.isAsymmetric();
+
+        for (int index = 0; index < kTableSize; ++index)
+        {
+            const auto u = juce::jmap (static_cast<float> (index),
+                                       0.0f, static_cast<float> (kTableSize - 1),
+                                       -kMaxWarped, kMaxWarped);
+            table[static_cast<size_t> (index)] = solveCircuit (unwarp (u), spec);
+        }
+
+        makeupGain = computeMakeupGain();
+    }
+
+    float process (float x) const noexcept
+    {
+        const auto u = warp (x);
+        const auto position = juce::jmap (juce::jlimit (-kMaxWarped, kMaxWarped, u),
+                                          -kMaxWarped, kMaxWarped,
+                                          0.0f, static_cast<float> (kTableSize - 1));
+        const auto lowIndex = static_cast<int> (position);
+        const auto highIndex = juce::jmin (lowIndex + 1, kTableSize - 1);
+        const auto fraction = position - static_cast<float> (lowIndex);
+
+        const auto a = table[static_cast<size_t> (lowIndex)];
+        const auto b = table[static_cast<size_t> (highIndex)];
+
+        return (a + fraction * (b - a)) * makeupGain;
+    }
+
+    bool needsDcBlocker() const noexcept { return asymmetric; }
+
+private:
+    static constexpr float kMaxWarped = 0.995f;
+
+    static float warp (float v) noexcept   { return v / (kWarp + std::abs (v)); }
+    static float unwarp (float u) noexcept { return kWarp * u / juce::jmax (1.0e-6f, 1.0f - std::abs (u)); }
+
+    /** Level-matches every circuit so switching models is a change of character,
+        not a jump in volume. Measured against a 0.5 V peak sine - a realistic
+        driven-guitar level - and normalised to a common output RMS. */
+    float computeMakeupGain() const
+    {
+        constexpr int   kSamples   = 2048;
+        constexpr float kTestPeak  = 0.5f;
+        constexpr float kTargetRms = 0.32f;
+
+        double sumOfSquares = 0.0;
+
+        for (int i = 0; i < kSamples; ++i)
+        {
+            const auto phase = juce::MathConstants<float>::twoPi * static_cast<float> (i)
+                             / static_cast<float> (kSamples);
+            const auto u = warp (kTestPeak * std::sin (phase));
+            const auto position = juce::jmap (juce::jlimit (-kMaxWarped, kMaxWarped, u),
+                                              -kMaxWarped, kMaxWarped,
+                                              0.0f, static_cast<float> (kTableSize - 1));
+            const auto lowIndex = static_cast<int> (position);
+            const auto highIndex = juce::jmin (lowIndex + 1, kTableSize - 1);
+            const auto fraction = position - static_cast<float> (lowIndex);
+            const auto a = table[static_cast<size_t> (lowIndex)];
+            const auto b = table[static_cast<size_t> (highIndex)];
+            const auto value = a + fraction * (b - a);
+
+            sumOfSquares += static_cast<double> (value) * static_cast<double> (value);
+        }
+
+        const auto rms = std::sqrt (sumOfSquares / static_cast<double> (kSamples));
+
+        return rms > 1.0e-6 ? juce::jlimit (0.05f, 20.0f, static_cast<float> (kTargetRms / rms)) : 1.0f;
+    }
+
+    std::array<float, kTableSize> table {};
+    float makeupGain = 1.0f;
+    bool  asymmetric = false;
+};
+
+} // namespace gas::circuits
diff --git a/Source/DSP/DynamicsModels.h b/Source/DSP/DynamicsModels.h
new file mode 100644
index 0000000..4201263
--- /dev/null
+++ b/Source/DSP/DynamicsModels.h
@@ -0,0 +1,247 @@
+#pragma once
+
+#include <JuceHeader.h>
+
+#include <array>
+#include <cmath>
+
+/**
+    One-knob models of three classic gain-reduction circuits.
+
+    Each one is driven entirely by the existing Drive control, exactly the way
+    the hardware works: an 1176 and an LA-2A have no threshold knob either. You
+    push more signal into a fixed threshold and the circuit responds. Automatic
+    make-up keeps the output level roughly constant as Drive comes up, so the
+    knob changes how hard it squeezes rather than how loud it is.
+
+    These are behavioural circuit models - the control element's gain law and the
+    detector's time constants are what define each unit's character, and both are
+    taken from the real topology:
+
+      Opto   Vactrol LED/LDR, R_ldr ~ 2.5k / I_mA, dual-slope release
+      FET    2N5457 as a voltage-controlled resistor, microsecond attack
+      VCA    THAT2180 exponential VCA fed by a true-RMS detector, over-easy knee
+*/
+namespace gas::dynamics
+{
+
+inline constexpr float kThresholdDbfs = -18.0f;   // fixed, as on the hardware
+
+/** Smoothed one-pole coefficient for a given time constant. */
+inline float timeConstantCoefficient (float milliseconds, double sampleRate) noexcept
+{
+    const auto seconds = juce::jmax (1.0e-5f, milliseconds * 0.001f);
+    return std::exp (-1.0f / (static_cast<float> (sampleRate) * seconds));
+}
+
+//==============================================================================
+/** Vactrol opto compressor - LA-2A / Tube-Tech CL 1B territory.
+
+    Sidechain drives an LED bonded to an LDR (VTL5C3, or a 5 mm red LED and a
+    GL5537 in heatshrink for about a dollar). The photocell's resistance sets
+    the gain of a shunt divider, and its recovery is the sound: a fast first
+    stage that gives back roughly half the reduction, then a long tail. That
+    dual slope is why an LA-2A breathes instead of pumping, and it falls out of
+    the photoconductor's physics rather than being dialled in.
+
+    Ratio is not a knob here either. The LDR's law gives roughly 3:1 at light
+    reduction, steepening past 8:1 as it clamps down - program dependence that
+    a fixed-ratio model cannot reproduce.
+*/
+class OptoCompressor
+{
+public:
+    void prepare (double sampleRate)
+    {
+        attackCoefficient      = timeConstantCoefficient (10.0f, sampleRate);
+        fastReleaseCoefficient = timeConstantCoefficient (60.0f, sampleRate);
+        slowReleaseCoefficient = timeConstantCoefficient (1800.0f, sampleRate);
+        reset();
+    }
+
+    void reset()
+    {
+        fastEnvelope = 0.0f;
+        slowEnvelope = 0.0f;
+    }
+
+    float process (float input) noexcept
+    {
+        const auto rectified = std::abs (input);
+
+        // Two detectors sharing one attack, splitting on release: the fast one
+        // recovers most of the reduction quickly, the slow one drags a tail.
+        fastEnvelope = trackEnvelope (fastEnvelope, rectified, attackCoefficient, fastReleaseCoefficient);
+        slowEnvelope = trackEnvelope (slowEnvelope, rectified, attackCoefficient, slowReleaseCoefficient);
+
+        const auto envelope = 0.55f * fastEnvelope + 0.45f * slowEnvelope;
+
+        // LED current is whatever the sidechain amp pushes above threshold.
+        const auto overThresholdDb = juce::Decibels::gainToDecibels (juce::jmax (1.0e-6f, envelope))
+                                   - kThresholdDbfs;
+
+        if (overThresholdDb <= 0.0f)
+            return input;
+
+        // Photocell law: R ~ 2.5k / I_mA, feeding a shunt divider. Expressed in
+        // dB this is close to linear with a gently steepening slope, which is
+        // where the rising ratio comes from.
+        const auto reductionDb = overThresholdDb * (0.34f + 0.020f * juce::jmin (overThresholdDb, 24.0f));
+
+        return input * juce::Decibels::decibelsToGain (-reductionDb);
+    }
+
+private:
+    static float trackEnvelope (float state, float target, float attack, float release) noexcept
+    {
+        const auto coefficient = (target > state) ? attack : release;
+        return target + coefficient * (state - target);
+    }
+
+    float attackCoefficient = 0.0f;
+    float fastReleaseCoefficient = 0.0f;
+    float slowReleaseCoefficient = 0.0f;
+    float fastEnvelope = 0.0f;
+    float slowEnvelope = 0.0f;
+};
+
+//==============================================================================
+/** FET compressor - 1176LN territory.
+
+    A 2N5457 JFET works as a voltage-controlled resistor in a shunt divider, so
+    the attack is measured in microseconds: fast enough to catch the leading
+    edge of a pick attack before it ever reaches the tanks. Ratio is 4:1 with a
+    moderate knee.
+
+    The FET is not a clean resistor while it is working - it contributes its own
+    low-order harmonics, and that grit is a large part of why an 1176 sounds
+    like an 1176 rather than like a transparent limiter. The harmonic term below
+    scales with gain reduction, so it only shows up when the circuit is actually
+    squeezing.
+*/
+class FetCompressor
+{
+public:
+    void prepare (double sampleRate)
+    {
+        attackCoefficient  = timeConstantCoefficient (0.15f, sampleRate);   // 150 us
+        releaseCoefficient = timeConstantCoefficient (250.0f, sampleRate);
+        reset();
+    }
+
+    void reset() { envelope = 0.0f; }
+
+    float process (float input) noexcept
+    {
+        const auto rectified = std::abs (input);
+        const auto coefficient = (rectified > envelope) ? attackCoefficient : releaseCoefficient;
+        envelope = rectified + coefficient * (envelope - rectified);
+
+        const auto envelopeDb = juce::Decibels::gainToDecibels (juce::jmax (1.0e-6f, envelope));
+        const auto overThresholdDb = envelopeDb - kThresholdDbfs;
+
+        auto reductionDb = 0.0f;
+
+        if (overThresholdDb > kKneeWidthDb * 0.5f)
+        {
+            reductionDb = overThresholdDb * (1.0f - 1.0f / kRatio);
+        }
+        else if (overThresholdDb > -kKneeWidthDb * 0.5f)
+        {
+            // Quadratic knee across the transition so the onset is not a corner.
+            const auto knee = overThresholdDb + kKneeWidthDb * 0.5f;
+            reductionDb = (1.0f - 1.0f / kRatio) * knee * knee / (2.0f * kKneeWidthDb);
+        }
+
+        auto output = input * juce::Decibels::decibelsToGain (-reductionDb);
+
+        // FET nonlinearity, proportional to how hard the FET is being driven.
+        const auto harmonicAmount = juce::jmin (0.16f, reductionDb * 0.010f);
+
+        if (harmonicAmount > 0.0f)
+            output += harmonicAmount * (output * output * output - output) * 0.5f;
+
+        return output;
+    }
+
+private:
+    static constexpr float kRatio       = 4.0f;
+    static constexpr float kKneeWidthDb = 6.0f;
+
+    float attackCoefficient = 0.0f;
+    float releaseCoefficient = 0.0f;
+    float envelope = 0.0f;
+};
+
+//==============================================================================
+/** VCA limiter - dbx 160 territory.
+
+    A THAT2180 exponential VCA under a true-RMS detector. RMS rather than peak
+    detection is the whole point: the circuit responds to how loud something
+    actually is rather than to its transient peaks, so it sits on a signal
+    instead of chattering at it.
+
+    "Over-easy" is dbx's name for the wide soft knee - compression starts well
+    below the nominal threshold and reaches full ratio well above it, which is
+    why a 160 can work hard without announcing itself. Ratio is 10:1, and the
+    detector watches the output (feedback topology), making the whole thing
+    markedly more program dependent than a feed-forward design.
+*/
+class VcaLimiter
+{
+public:
+    void prepare (double sampleRate)
+    {
+        rmsCoefficient     = timeConstantCoefficient (10.0f, sampleRate);
+        releaseCoefficient = timeConstantCoefficient (120.0f, sampleRate);
+        reset();
+    }
+
+    void reset()
+    {
+        meanSquare = 0.0f;
+        gainReductionDb = 0.0f;
+    }
+
+    float process (float input) noexcept
+    {
+        // True RMS detector on the output (feedback topology).
+        const auto fedBack = input * juce::Decibels::decibelsToGain (-gainReductionDb);
+        const auto squared = fedBack * fedBack;
+        meanSquare = squared + rmsCoefficient * (meanSquare - squared);
+
+        const auto rmsDb = juce::Decibels::gainToDecibels (juce::jmax (1.0e-6f, std::sqrt (meanSquare)));
+        const auto overThresholdDb = rmsDb - kThresholdDbfs;
+
+        auto targetReductionDb = 0.0f;
+
+        if (overThresholdDb > kOverEasyDb * 0.5f)
+        {
+            targetReductionDb = overThresholdDb * (1.0f - 1.0f / kRatio);
+        }
+        else if (overThresholdDb > -kOverEasyDb * 0.5f)
+        {
+            const auto knee = overThresholdDb + kOverEasyDb * 0.5f;
+            targetReductionDb = (1.0f - 1.0f / kRatio) * knee * knee / (2.0f * kOverEasyDb);
+        }
+
+        // The VCA follows the detector immediately going down and eases back up.
+        if (targetReductionDb > gainReductionDb)
+            gainReductionDb = targetReductionDb;
+        else
+            gainReductionDb = targetReductionDb + releaseCoefficient * (gainReductionDb - targetReductionDb);
+
+        return input * juce::Decibels::decibelsToGain (-gainReductionDb);
+    }
+
+private:
+    static constexpr float kRatio     = 10.0f;
+    static constexpr float kOverEasyDb = 12.0f;
+
+    float rmsCoefficient = 0.0f;
+    float releaseCoefficient = 0.0f;
+    float meanSquare = 0.0f;
+    float gainReductionDb = 0.0f;
+};
+
+} // namespace gas::dynamics
